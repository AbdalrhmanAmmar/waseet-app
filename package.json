    "react-native-screens": "~4.26.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "world-countries": "^5.1.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "android:build": "expo run:android",
    "ios:build": "expo run:ios",
    "export:check": "expo export --platform all --output-dir dist",
    "test:e2e": "expo export --platform web --output-dir dist && playwright test",
    "format": "prettier --write src tests app.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests app.config.ts playwright.config.ts",
    "start:dev": "expo start --dev-client",
    "ios:dev": "expo start --dev-client --ios",
    "android:dev": "expo start --dev-client --android",
    "assets:generate": "node scripts/generate-brand-assets.mjs"
  },
  "private": true
}
